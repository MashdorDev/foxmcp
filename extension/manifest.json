{
  "manifest_version": 2,
  "name": "MCP Bridge for Firefox",
  "version": "1.4.1",
  "description": "Let Claude, Cursor or any MCP client use your Firefox: read pages, click, type, upload files and take screenshots, with no automation mode.",
  "author": "Dor Zairi (based on FoxMCP by ThinkerYzu)",
  "homepage_url": "https://github.com/MashdorDev/mcp-bridge-for-firefox",
  "license": "MIT",
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "history",
    "bookmarks",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "MCP Bridge for Firefox"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxmcp@dorzairi.dev"
    }
  }
}
